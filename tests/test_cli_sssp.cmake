if(NOT DEFINED CLI OR NOT DEFINED WORK)
    message(FATAL_ERROR "CLI and WORK required")
endif()
file(MAKE_DIRECTORY "${WORK}")
set(graph "${WORK}/graph with spaces.txt")
file(WRITE "${graph}" "5 4\n0 1 4294967295\n1 2 4294967295\n0 3 0\n3 3 0\n")
execute_process(COMMAND "${CLI}" sssp --input "${graph}" --source 0 --algorithm dijkstra
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
set(expected "{\"schema_version\":1,\"algorithm\":\"dijkstra\",\"source\":0,\"distances\":[0,4294967295,8589934590,0,null]}\n")
if(NOT status EQUAL 0 OR NOT output STREQUAL expected OR NOT error STREQUAL "")
    message(FATAL_ERROR "Unexpected SSSP response: ${status}: ${output}: ${error}")
endif()
function(reject)
    execute_process(COMMAND "${CLI}" ${ARGN} RESULT_VARIABLE status
        OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT status EQUAL 2 OR NOT output STREQUAL "" OR error STREQUAL "")
        message(FATAL_ERROR "Expected diagnostic and status 2: ${ARGN}: ${status}: ${output}: ${error}")
    endif()
endfunction()
foreach(source IN ITEMS -1 +1 1x 4294967296 5 "")
    reject(sssp --input "${graph}" --source "${source}" --algorithm dijkstra)
endforeach()
reject(sssp)
reject(sssp --input "${graph}" --source 0)
reject(sssp --input "${graph}" --source 0 --algorithm other)
reject(sssp --input "${graph}" --source 0 --algorithm dijkstra --source 1)
reject(sssp --input "${graph}" --source 0 --algorithm dijkstra --input "${graph}")
reject(sssp --input "${graph}" --source 0 --algorithm dijkstra --algorithm dijkstra)
reject(sssp --input "${graph}" --source 0 --algorithm dijkstra --unknown value)
reject(sssp --input "${graph}" --source 0 --algorithm)
reject(sssp --input "${WORK}/missing.txt" --source 0 --algorithm dijkstra)
file(WRITE "${WORK}/empty.txt" "0 0\n")
reject(sssp --input "${WORK}/empty.txt" --source 0 --algorithm dijkstra)
file(WRITE "${WORK}/malformed.txt" "2 1\n0 1 -1\n")
reject(sssp --input "${WORK}/malformed.txt" --source 0 --algorithm dijkstra)
