if(NOT DEFINED CLI OR NOT DEFINED WORK)
    message(FATAL_ERROR "CLI and WORK required")
endif()
file(MAKE_DIRECTORY "${WORK}")
set(graph "${WORK}/graph with spaces.txt")
file(WRITE "${graph}" "5 4\n0 1 4294967295\n1 2 4294967295\n0 3 0\n3 3 0\n")
execute_process(COMMAND "${CLI}" sssp --input "${graph}" --source 0 --algorithm dijkstra
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
set(expected "{\"schema_version\":1,\"algorithm\":\"dijkstra\",\"source\":0,\"distances\":[0,4294967295,8589934590,0,null]}\n")
if(NOT status EQUAL 0 OR NOT output STREQUAL expected OR NOT error STREQUAL "")
    message(FATAL_ERROR "Unexpected SSSP response: ${status}: ${output}: ${error}")
endif()
function(reject)
    execute_process(COMMAND "${CLI}" ${ARGN} RESULT_VARIABLE status
        OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT status EQUAL 2 OR NOT output STREQUAL "" OR error STREQUAL "")
        message(FATAL_ERROR "Expected diagnostic and status 2: ${ARGN}: ${status}: ${output}: ${error}")
    endif()
endfunction()
foreach(source IN ITEMS -1 +1 1x 4294967296 5)
    reject(sssp --input "${graph}" --source "${source}" --algorithm dijkstra)
endforeach()
reject(sssp)
reject(sssp --input "${graph}" --source 0)
reject(sssp --input "${graph}" --source 0 --algorithm other)
reject(sssp --input "${graph}" --source 0 --algorithm dijkstra --source 1)
reject(sssp --input "${graph}" --source 0 --algorithm dijkstra --input "${graph}")
reject(sssp --input "${graph}" --source 0 --algorithm dijkstra --algorithm dijkstra)
reject(sssp --input "${graph}" --source 0 --algorithm dijkstra --unknown value)
reject(sssp --input "${graph}" --source 0 --algorithm)
reject(sssp --input "${WORK}/missing.txt" --source 0 --algorithm dijkstra)
file(WRITE "${WORK}/empty.txt" "0 0\n")
reject(sssp --input "${WORK}/empty.txt" --source 0 --algorithm dijkstra)
file(WRITE "${WORK}/malformed.txt" "2 1\n0 1 -1\n")
reject(sssp --input "${WORK}/malformed.txt" --source 0 --algorithm dijkstra)

# Keep the empty argv element: expanding ARGN would drop it.
execute_process(COMMAND "${CLI}" sssp --input "${graph}" --source "" --algorithm dijkstra
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT status EQUAL 2 OR NOT output STREQUAL "" OR NOT error MATCHES "Source must")
    message(FATAL_ERROR "Explicit empty source was not rejected correctly: ${status}: ${error}")
endif()
foreach(delta IN ITEMS 1 2 3 16 4294967295 18446744073709551615)
    foreach(threads IN ITEMS 0 1 2)
        execute_process(COMMAND "${CLI}" sssp --input "${graph}" --source 0
            --algorithm delta-stepping --delta "${delta}" --threads "${threads}"
            RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(NOT status EQUAL 0 OR NOT error STREQUAL "")
            message(FATAL_ERROR "Delta CLI failed: ${status}: ${error}")
        endif()
        string(JSON actual GET "${output}" actual_threads)
        if(actual LESS 1)
            message(FATAL_ERROR "Invalid actual team size")
        endif()
        set(expected "{\"schema_version\":1,\"algorithm\":\"delta-stepping\",\"source\":0,\"delta\":${delta},\"requested_threads\":${threads},\"actual_threads\":${actual},\"distances\":[0,4294967295,8589934590,0,null]}\n")
        if(NOT output STREQUAL expected)
            message(FATAL_ERROR "Unexpected delta JSON: ${output}")
        endif()
        if(threads GREATER 0 AND actual GREATER threads)
            message(FATAL_ERROR "Actual team exceeds request")
        endif()
    endforeach()
endforeach()
foreach(delta IN ITEMS 0 -1 +1 1x 18446744073709551616)
    reject(sssp --input "${graph}" --source 0 --algorithm delta-stepping --delta "${delta}")
endforeach()
foreach(threads IN ITEMS -1 +1 1x 2147483648)
    reject(sssp --input "${graph}" --source 0 --algorithm delta-stepping --delta 16 --threads "${threads}")
endforeach()
reject(sssp --input "${graph}" --source 0 --algorithm delta-stepping)
reject(sssp --input "${graph}" --source 0 --algorithm dijkstra --delta 16)
reject(sssp --input "${graph}" --source 0 --algorithm dijkstra --threads 2)
reject(sssp --input "${graph}" --source 0 --algorithm delta-stepping --delta 16 --delta 16)
reject(sssp --input "${graph}" --source 0 --algorithm delta-stepping --delta 16 --threads 2 --threads 2)
execute_process(COMMAND "${CLI}" sssp --input "${graph}" --source 0
    --algorithm delta-stepping --delta 16 RESULT_VARIABLE status OUTPUT_VARIABLE output)
if(NOT status EQUAL 0 OR NOT output MATCHES "\"requested_threads\":0")
    message(FATAL_ERROR "Default threads omitted from JSON")
endif()
